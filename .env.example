# ─── Acceso al panel ───────────────────────────────────────────
# Contraseña única del operador (obligatoria).
ADMIN_PASSWORD=
# Clave para firmar la cookie de sesión. Opcional pero recomendada:
# si se omite se usa ADMIN_PASSWORD. Genera una con: openssl rand -hex 32
AUTH_SECRET=

# ─── Upstash Redis (obligatorio) ───────────────────────────────
# Única base de datos del sistema: conversaciones, memoria de la IA, estado y agenda.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OpenAI (motor de Gema) ────────────────────────────────────
OPENAI_API_KEY=
# Opcional. Por defecto gpt-4o-mini (también analiza las fotos que envían los clientes).
OPENAI_MODEL=gpt-4o-mini
# Opcional. Transcripción de notas de voz; por defecto gpt-4o-mini-transcribe.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ─── Bold (links de pago del anticipo) ─────────────────────────
# Llave de identidad de "Botón de pagos" (panel de Bold → Integraciones). La usa
# lib/bold.ts contra "API Link de pagos". Sin ella, no se generan links.
BOLD_API_KEY=

# ─── Meta WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token que tú inventas y pegas en Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración > Básica). Sin él, el webhook rechaza todo.
WHATSAPP_APP_SECRET=

# ─── Protección de cuota de IA (opcional) ──────────────────────
# Respuestas de Gema por número cada 10 min. Al superarlo, el chat se marca como "Requiere asesor".
AI_MAX_REPLIES_PER_PHONE=15
# Respuestas de Gema en total por hora.
AI_MAX_REPLIES_PER_HOUR=300

# ─── Zona horaria de la clínica (opcional) ─────────────────────
# Define el día contable, la grilla de la agenda y las horas que ve Gema.
# El offset debe ser fijo (sin horario de verano) y corresponder a la zona anterior.
CLINIC_TIMEZONE=America/Bogota
CLINIC_UTC_OFFSET=-05:00
